# GHOST Configuration File

# Operational Identity
GHOST_CALLSIGN=GHOST
GHOST_OPERATOR_NAME=Sir
GHOST_SECURITY_LEVEL=DEFCON_3

# LLM Core Engines
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
CLAUDE_MODEL=claude-3-7-sonnet-20250219
GEMINI_MODEL=gemini-2.5-flash

# Central Command Center (FastAPI & WebSockets)
HOST=0.0.0.0
PORT=8080
GHOST_GATEWAY_SECRET=generate_a_secure_token_here

# Device Integration
WINDOWS_AGENT_ENABLED=true
ANDROID_GATEWAY_ENABLED=true
NOTIFICATION_LISTENER_PORT=8081

# Voice Systems
WAKE_WORD=ghost
TTS_ENGINE=edge-tts
STT_ENGINE=faster-whisper
VOICE_GENDER=male

# Security & Permissions
DEFAULT_PERMISSION_LEVEL=LEVEL_2_EXECUTE
REQUIRE_CONFIRMATION_LEVEL_3=true

